{
  "name": "tool-zoo",
  "version": "0.1.0",
  "description": "AI創業者的一盒化解決方案 - 單人友好、意見強、開箱有SLO與E2E、內含前/後對照Dashboard",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out dist coverage test-results",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "deploy": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh",
    "deploy:setup": "chmod +x scripts/supabase-setup.sh && ./scripts/supabase-setup.sh",
    "deploy:vercel": "vercel --prod",
    "deploy:staging": "vercel",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "test:email": "node scripts/send-welcome-email.js",
    "test:analytics": "echo 'Analytics system is ready for testing'",
    "test:website": "node test-website.js",
    "test:health": "curl -s http://localhost:3000/api/health | jq .",
    "test:performance": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json"
  },
  "dependencies": {
    "@stripe/stripe-js": "^2.4.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tanstack/react-query": "^5.17.0",
    "lucide-react": "^0.541.0",
    "next": "15.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "15.2.4",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
